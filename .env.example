# Green Bean Environment Variables Template
# Copy to .env for local runtime or deployment environments

DEBUG=False
SECRET_KEY=generate-a-minimum-50-character-production-key-here
ALLOWED_HOSTS=greenbean.app,*.greenbean.app,127.0.0.1,localhost
DATABASE_URL=sqlite:///app/data/greenbean.sqlite3
# or PostgreSQL: postgres://greenbean:secret@postgres-service:5432/greenbean
